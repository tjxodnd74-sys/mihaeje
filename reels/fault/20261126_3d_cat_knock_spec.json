"caps":[[0.0,"추운 날 아침,",1.3],[1.38,"시동 걸기 전에 보닛부터 두드려 보세요",3.5],[3.68,"따뜻한 엔진룸이나 차 밑에",5.2],[5.3,"길고양이가 숨어 있을 수 있습니다",7.0],[7.48,"농림축산식품부가 안내한 방법은",9.2],[9.26,"4가지입니다",10.0],[10.18,"첫째, 타기 전에 보닛을 똑똑 두드리고",12.3],[12.42,"울음소리가 나는지 들어 봅니다",14.2],[14.4,"둘째, 차 문을 세게 닫으면",16.35],[16.42,"놀란 고양이가 밖으로 빠져나갑니다",18.7],[18.9,"셋째, 자리에 앉아",20.0],[20.06,"발을 굴러 진동을 줍니다",21.8],[22.02,"차 밑에 있던 고양이가",23.0],[23.06,"스스로 피할 수 있어요",24.5],[24.68,"넷째, 경적을 가볍게 울립니다",26.7],[26.86,"다만 이른 새벽이나 밤에는",28.0],[28.04,"이웃을 생각해 경적은 참아 주세요",29.6],[29.7,"노크, 문 닫기, 발 구르기, 경적",32.2],[32.36,"겨울 아침 시동 전에",33.25],[33.3,"이 4가지만 기억하세요",34.9]]}
