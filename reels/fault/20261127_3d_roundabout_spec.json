"caps":[[0.0,"회전교차로 앞에서",1.42],[1.42,"누가 먼저 갈지 멈칫한 적 있으시죠?",3.78],[4.3,"이미 안에서 돌고 있는 차가 먼저입니다",6.18],[6.54,"첫 번째",7.02],[7.36,"들어가기 전엔 속도를 줄이거나",8.72],[8.72,"잠깐 멈춥니다",9.66],[9.84,"차들은 시계 반대 방향으로 도니까",11.56],[11.56,"왼쪽에서 오는 차를 보세요",12.86],[13.3,"두 번째",13.72],[14.06,"안에 차가 오고 있으면",14.9],[14.9,"먼저 보내고 들어갑니다",16.12],[16.34,"들어가는 차가 양보하는 게",17.48],[17.48,"법으로 정해진 규칙입니다",18.64],[18.98,"세 번째",19.32],[19.64,"들어갈 때도, 나갈 때도",20.62],[20.62,"깜빡이를 켭니다",21.46],[21.6,"천천히, 안쪽 차 먼저, 깜빡이",24.02],[24.56,"회전교차로에선 이 세 가지만 기억하세요",26.68]]}
