[[0.0, "출근길에 앞유리가 뿌옇게", 2.02], [2.02, "김이 서리면", 2.74], [2.74, "어떤 버튼부터 누르시나요?", 5.14], [5.14, "손으로 닦으면 얼룩이 남고", 6.9], [6.9, "금방 다시 흐려집니다", 8.96], [8.96, "정답은 이 버튼", 10.9], [10.9, "앞유리 성에 제거 버튼입니다", 13.42], [13.42, "이 버튼을 누르면 바람이", 14.94], [14.94, "앞유리로 모이고", 15.84], [15.84, "차에 따라 에어컨과 외기 유입이", 18.6], [18.6, "자동으로 켜집니다", 20.26], [20.26, "에어컨은 공기 속 습기를 줄이고", 22.36], [22.36, "바깥 공기가 들어오면서", 23.89], [23.89, "김이 빠르게 걷힙니다", 26.07], [26.07, "바람이 차갑게 느껴지면", 27.5], [27.5, "온도만 따뜻하게 올리면 됩니다", 30.06], [30.06, "그리고 앞유리 아래 바깥 공기 흡입구에", 33.02], [33.02, "쌓인 눈이나 낙엽도 치워 주세요", 35.74], [35.74, "여기가 막히면 김이 잘", 37.2], [37.2, "빠지지 않습니다", 38.76], [38.76, "김이 서리면 손 말고", 40.3], [40.3, "성에 제거 버튼부터 누르세요", 42.84]]