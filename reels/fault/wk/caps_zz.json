[[0.0, "도로에 이런 지그재그 선", 2.1], [2.1, "그냥 장식인 줄 아셨나요?", 4.26], [4.26, "이 선은 법으로 정한", 5.64], [5.64, "서행 표시입니다", 7.0], [7.0, "정식 이름은 지그재그", 8.78], [8.78, "서행 표시이고", 10.08], [10.08, "곧 횡단보도가 나온다는 뜻입니다", 13.08], [13.08, "주로 어린이보호구역이나 보행자", 15.34], [15.34, "사고가 잦은 곳에 그려집니다", 17.54], [17.54, "그래서 이 선이 보이면", 18.82], [18.82, "보는 즉시 속도를 줄여야 합니다", 22.16], [22.16, "비슷한 표시가 하나 더 있습니다", 24.56], [24.56, "바닥에 그려진 마름모", 26.3], [26.3, "다이아몬드 표시입니다", 27.78], [27.78, "이건 앞에 횡단보도가 있다고 미리", 30.48], [30.48, "알려 주는 예고 표시입니다", 32.62], [32.62, "지그재그도", 33.46], [33.46, "마름모도", 34.4], [34.4, "뜻은 하나입니다", 35.96], [35.96, "곧 사람이 건널 수 있으니 천천히", 38.54], [38.54, "가라는 신호입니다", 40.1], [40.1, "이 두 표시가 보이면", 41.22], [41.22, "발은 브레이크 위로 옮기세요", 43.64]]