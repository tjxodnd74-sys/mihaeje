<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mihaeje_background</item>
        <item name="colorPrimaryDark">@color/mihaeje_background</item>
        <item name="colorAccent">@color/mihaeje_paper</item>
        <item name="android:windowBackground">@color/mihaeje_background</item>
    </style>

    <!-- 앱이 켜진 뒤 테마: 상태바·내비게이션바 자리는 이 바탕색으로 보인다 (MainActivity 가 웹 화면을 바 안쪽으로 줄임) -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/mihaeje_background</item>
        <item name="android:statusBarColor">@color/mihaeje_background</item>
        <item name="android:navigationBarColor">@color/mihaeje_background</item>
    </style>

    <!-- 켜지는 동안 화면 (안드로이드 12 이상은 windowSplashScreen*, 그 아래는 splash.png) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/mihaeje_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
